{
    "name": "discord-adapter-js",
    "description": "get and send messages with discord",

    "version": "0.1.0",

    "capabilities": "input",
    "root_file": "./discord-adapter.mjs",
    "launch_command": "node",
    "command_flags": [
	"--v8-pool-size=N",
	"--trace-turbo",
	"--prof",
	"--experimental-strip-types",
	"--trace-opt"
    ],
    "autostart": true
}

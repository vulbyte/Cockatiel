            let mut db_path_valid:bool = false;
            while(!db_path_valid){
                println!("what is the new path? (~/ does not work, exclude the name, as renaming is not supported)");
                io:stdin().read_line(&mut db_path);
                if db_path.is_dir() {
                    println!("path is valid! gj");
                    db_path_valid = true;
                }
                else {
                    println!("path is invalid, id the dir correct?");
                    db_path_valid = false;
                }
            }
        }
        else {
            db_log!("user chose to use default paths: \n\t db:");
        }
    }

    pub fn connect(function) -> {
        Self.listeners.push(function);
    }
}
